    <ProjectReference Include="../LazyTuiHub.Nodes/LazyTuiHub.Nodes.csproj" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.85.0" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <BundledPlugin Include="../../plugins/LazyTuiHub.Plugin.TuiHub.Core/runtime/LazyTuiHub.Plugin.TuiHub.Core.csproj" Required="true" />
