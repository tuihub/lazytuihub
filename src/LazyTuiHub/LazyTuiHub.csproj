    <BundledPlugin Include="../../plugins/LazyTuiHub.Plugin.TuiHub.Games/runtime/LazyTuiHub.Plugin.TuiHub.Games.csproj" />
    <BundledPlugin Include="../../plugins/LazyTuiHub.Plugin.TuiHub.Steam/LazyTuiHub.Plugin.TuiHub.Steam.csproj" />
    <BundledPlugin Include="../../plugins/LazyTuiHub.Plugin.TuiHub.Bangumi/LazyTuiHub.Plugin.TuiHub.Bangumi.csproj" />
    <BundledPlugin Include="../../plugins/LazyTuiHub.Plugin.TuiHub.Vndb/LazyTuiHub.Plugin.TuiHub.Vndb.csproj" />
    <BundledPlugin Include="../../plugins/LazyTuiHub.Plugin.TuiHub.Games/desktop/LazyTuiHub.Plugin.TuiHub.Games.Desktop.csproj" />
