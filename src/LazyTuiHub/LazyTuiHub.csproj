    <OutputType>Exe</OutputType>
    <PublishSelfContained>true</PublishSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LazyTuiHub.Cli/LazyTuiHub.Cli.csproj" />
    <ProjectReference Include="../LazyTuiHub.Desktop/LazyTuiHub.Desktop.csproj" />
