<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LazyTuiHub.Games.Desktop"
    xmlns:g="clr-namespace:LazyTuiHub.Games;assembly=LazyTuiHub.Games"
    x:Class="LazyTuiHub.Games.Desktop.GameSourcesPanel"
    x:DataType="local:GamePageModel"
>
    <UserControl.Styles>
        <Style Selector="Border.sourceCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter
                Property="CornerRadius"
                Value="{DynamicResource RowRadius}"
            /><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /><Setter
                Property="BorderThickness"
                Value="1"
            /><Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <Button
            Classes="quiet"
            x:Name="ReturnToShelf"
            Margin="0,12"
            HorizontalAlignment="Left"
            Click="Back"
            AutomationProperties.Name="Back to games"
        >
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon
                    Classes="action inline"
                    Data="{DynamicResource ActionIconBack}"
                /><TextBlock Text="Games" />
            </StackPanel>
        </Button>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,20" HorizontalAlignment="Stretch" Spacing="20">
                <TextBlock Text="Sources and folders" Classes="title" />
                <Grid
                    x:Name="Sections"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="18"
                    RowSpacing="12"
                >
                    <StackPanel Spacing="10">
                        <TextBlock Text="Online accounts" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Platforms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:GamePlatformGroup">
                                    <Border Classes="sourceCard">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        Classes="item-title"
                                                    /><TextBlock
                                                        Text="{Binding State}"
                                                        Classes="metadata"
                                                        IsVisible="{Binding !!State}"
                                                    />
                                                </StackPanel><Button
                                                    Grid.Column="1"
                                                    Classes="secondary"
                                                    Content="Connect"
                                                    Click="Connect"
                                                    IsVisible="{Binding CanConnect}"
                                                />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Accounts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:GameOriginRow">
                                                        <StackPanel Margin="0,6,0,0" Spacing="3">
                                                            <TextBlock
                                                                Text="{Binding Origin.Label}"
                                                                Classes="label"
                                                            /><TextBlock
                                                                Text="{Binding Origin.Description}"
                                                                Classes="metadata"
                                                                TextWrapping="Wrap"
                                                            /><WrapPanel>
                                                                <Button
                                                                    Classes="quiet"
                                                                    Content="Sync"
                                                                    Click="Sync"
                                                                    IsVisible="{Binding CanRefresh}"
                                                                /><Button
                                                                    Classes="quiet"
                                                                    Content="Disconnect"
                                                                    Click="Disconnect"
                                                                    IsVisible="{Binding CanDisconnect}"
                                                                    ToolTip.Tip="Disconnect and keep the last snapshot"
                                                                />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="Directories" Grid.Column="1" Spacing="10">
                        <TextBlock Text="Local folders" Classes="section" />
                        <ItemsControl
                            ItemsSource="{Binding Scanners}"
                            IsVisible="{Binding CanScan}"
                        >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="g:IInstallationScanner">
                                    <Border Classes="sourceCard">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    Classes="item-title"
                                                    Text="{Binding Id,Converter={x:Static local:GameNames.Scanner}}"
                                                />
                                                <TextBlock
                                                    Classes="metadata"
                                                    Text="{Binding Id,Converter={x:Static local:GameNames.ScannerHelp}}"
                                                />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Classes="secondary"
                                                Click="ChooseScanner"
                                                Content="Scan…"
                                                AutomationProperties.Name="{Binding Id,Converter={x:Static local:GameNames.Scanner}}"
                                            />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:GameOriginRow">
                                    <Border Classes="sourceCard">
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                Classes="label"
                                                Text="{Binding Origin.Label}"
                                                TextWrapping="Wrap"
                                            /><TextBlock
                                                Classes="metadata"
                                                Text="{Binding Origin.Description}"
                                            /><WrapPanel>
                                                <Button
                                                    Classes="quiet"
                                                    Content="Rescan"
                                                    Click="Rescan"
                                                    IsVisible="{Binding CanRefresh}"
                                                /><Button
                                                    Classes="quiet"
                                                    Content="Disconnect"
                                                    Click="Disconnect"
                                                    IsVisible="{Binding CanDisconnect}"
                                                    ToolTip.Tip="Disconnect and keep the last snapshot"
                                                />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
