<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LazyTuiHub.Games.Desktop"
    xmlns:g="clr-namespace:LazyTuiHub.Games;assembly=LazyTuiHub.Games"
    x:Class="LazyTuiHub.Games.Desktop.GameWorkshop"
    x:DataType="local:GamePageModel"
>
    <Grid RowDefinitions="Auto,*" MaxWidth="720">
        <Button
            Classes="quiet"
            x:Name="Return"
            HorizontalAlignment="Left"
            Margin="0,12"
            Click="Back"
            IsEnabled="{Binding Idle}"
        >
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon
                    Classes="action inline"
                    Data="{DynamicResource ActionIconBack}"
                /><TextBlock Text="Back" />
            </StackPanel>
        </Button>
        <ScrollViewer x:Name="Scroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,24" Spacing="16">
                <TextBlock Classes="headline" Text="{Binding SheetTitle}" TextWrapping="Wrap" />
                <StackPanel IsVisible="{Binding InAdd}" Spacing="12">
                    <TextBlock Classes="label" Text="Game title" /><TextBox
                        x:Name="NewTitle"
                        Text="{Binding DraftTitle,Mode=TwoWay}"
                        KeyDown="AddKey"
                    /><Button
                        x:Name="Create"
                        HorizontalAlignment="Left"
                        Classes="accent"
                        Content="Add to library"
                        Click="Add"
                        IsEnabled="{Binding !!#NewTitle.Text}"
                    />
                </StackPanel>
                <StackPanel IsVisible="{Binding Connecting}" Spacing="12">
                    <TextBlock x:Name="SignInHelp" Classes="caption" TextWrapping="Wrap" />
                    <StackPanel IsVisible="{Binding Platform.UsesToken}" Spacing="6">
                        <TextBlock Text="Personal access token" Classes="label" /><TextBox
                            x:Name="Secret"
                            PasswordChar="●"
                            AutomationProperties.Name="Personal access token"
                        /><Button
                            Classes="quiet"
                            HorizontalAlignment="Left"
                            Content="Get a token"
                            Click="GetToken"
                        />
                    </StackPanel>
                    <WrapPanel>
                        <Button
                            x:Name="Connect"
                            Classes="accent"
                            Click="BindAccount"
                            IsEnabled="{Binding Idle}"
                        /><Button
                            Classes="quiet"
                            Content="Cancel sign-in"
                            Click="CancelSignIn"
                            IsVisible="{Binding Busy}"
                        />
                    </WrapPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding Scanning}" Spacing="12">
                    <TextBlock
                        x:Name="FolderHelp"
                        Classes="caption"
                        TextWrapping="Wrap"
                    /><TextBlock Text="Folder path" Classes="label" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="Folder" Text="{Binding FolderPath,Mode=TwoWay}" /><Button
                            Grid.Column="1"
                            Classes="secondary"
                            Content="Browse…"
                            Click="ChooseFolder"
                        />
                    </Grid>
                    <Button
                        HorizontalAlignment="Left"
                        Classes="accent"
                        Content="Scan folder"
                        Click="Scan"
                        IsEnabled="{Binding Idle}"
                    />
                </StackPanel>
                <StackPanel IsVisible="{Binding Identifying}" Spacing="14">
                    <TextBlock Classes="item-title" Text="{Binding Selected.Entry.Title}" />
                    <TextBlock
                        Text="Linked sources"
                        Classes="section"
                        IsVisible="{Binding HasSources}"
                    />
                    <ItemsControl ItemsSource="{Binding Selected.Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="g:GameMetadata">
                                <StackPanel Spacing="3" Margin="0,2,0,10">
                                    <TextBlock
                                        Classes="item-title"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap"
                                    /><TextBlock Classes="metadata">
                                        <Run Text="{Binding Provider,Converter={x:Static local:GameNames.Platform}}" /><Run Text=" · " /><Run Text="{Binding ExternalId}" />
                                    </TextBlock><WrapPanel>
                                        <Button
                                            Classes="quiet"
                                            Content="Refresh"
                                            Click="LinkRecord"
                                        /><Button Classes="quiet" Content="Unlink" Click="Unlink" />
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Text="Suggested matches"
                        Classes="section"
                        IsVisible="{Binding !!Matches.Count}"
                    />
                    <ItemsControl ItemsSource="{Binding Matches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="g:CatalogKey">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Provider,Converter={x:Static local:GameNames.Platform}}" /><Run Text=" · " /><Run Text="{Binding Id}" />
                                    </TextBlock><Button
                                        Grid.Column="1"
                                        Content="Link"
                                        Classes="secondary"
                                        Click="LinkSuggestion"
                                    />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Search catalogs" Classes="section" /><ComboBox
                        x:Name="Catalog"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Providers}"
                        SelectedIndex="0"
                        DisplayMemberBinding="{Binding Id,DataType=g:GameAccountProvider,Converter={x:Static local:GameNames.Platform}}"
                    />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox
                            x:Name="Query"
                            PlaceholderText="Game title or alias"
                            KeyDown="QueryKey"
                        /><Button
                            x:Name="SearchCatalog"
                            Grid.Column="1"
                            Classes="secondary"
                            Content="Search"
                            Click="Search"
                        />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="g:GameMetadata">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,6">
                                    <StackPanel>
                                        <TextBlock
                                            Classes="item-title"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap"
                                        /><TextBlock
                                            Classes="metadata"
                                            Text="{Binding AlternativeTitle}"
                                            IsVisible="{Binding !!AlternativeTitle}"
                                        /><TextBlock Classes="caption">
                                            <Run Text="{Binding Provider,Converter={x:Static local:GameNames.Platform}}" /><Run Text=" · " /><Run Text="{Binding ExternalId}" /><Run Text="  " /><Run Text="{Binding ReleaseDate}" />
                                        </TextBlock>
                                    </StackPanel><Button
                                        Grid.Column="1"
                                        Classes="secondary"
                                        Content="Link"
                                        Click="LinkRecord"
                                    />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding Editing}" Spacing="12">
                    <TextBlock Text="Library title" Classes="label" /><TextBox
                        x:Name="EditTitle"
                        Text="{Binding DraftTitle,Mode=TwoWay}"
                    />
                    <TextBlock
                        Text="Categories"
                        Classes="label"
                    /><ItemsControl ItemsSource="{Binding DraftCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel><ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button
                                    Classes="quiet"
                                    Click="RemoveCategory"
                                    ToolTip.Tip="Remove category"
                                >
                                    <TextBlock><Run Text="{Binding}" /><Run Text=" ×" /></TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox x:Name="NewCategory" PlaceholderText="New category" /><Button
                            Grid.Column="1"
                            Classes="secondary"
                            Content="Add category"
                            Click="AddCategory"
                        />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DraftFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:GameFieldDraft">
                                <StackPanel Spacing="4" Margin="0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Classes="label"
                                            Text="{Binding Name}"
                                        /><TextBlock
                                            Grid.Column="1"
                                            Classes="metadata"
                                            Text="{Binding Source}"
                                        />
                                    </Grid><TextBox
                                        Text="{Binding Value,Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="{Binding Multiline}"
                                        AutomationProperties.Name="{Binding Name}"
                                    /><Button
                                        Classes="quiet"
                                        Content="Reset to source"
                                        HorizontalAlignment="Left"
                                        Click="ResetField"
                                        IsVisible="{Binding CanReset}"
                                    />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <Button
                            x:Name="Save"
                            Classes="accent"
                            Content="Save changes"
                            Click="SaveInfo"
                        /><Button Classes="quiet" Content="Cancel" Click="Back" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding Moving}" Spacing="10">
                    <TextBlock
                        Text="{Binding ObservationName}"
                        Classes="caption"
                        TextWrapping="Wrap"
                    /><TextBlock Text="Move to an existing game" Classes="section" /><TextBox
                        x:Name="TargetSearch"
                        PlaceholderText="Find a game"
                        TextChanged="TargetChanged"
                    />
                    <ListBox
                        x:Name="Target"
                        ItemsSource="{Binding Targets}"
                        MaxHeight="200"
                        Classes="collection"
                        DisplayMemberBinding="{Binding Title,DataType=g:GameShelfItem}"
                    /><Button
                        Classes="secondary"
                        HorizontalAlignment="Left"
                        Content="Move here"
                        IsEnabled="{Binding !!#Target.SelectedItem}"
                        Click="Move"
                    />
                    <StackPanel Spacing="8" IsVisible="{Binding CanAdd}">
                        <TextBlock Text="Split into a new game" Classes="section" /><TextBox
                            x:Name="SplitTitle"
                            Text="{Binding DraftTitle,Mode=TwoWay}"
                        /><Button
                            x:Name="Split"
                            HorizontalAlignment="Left"
                            Classes="secondary"
                            Content="Create game and move entry"
                            Click="SplitEntry"
                        />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
