<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LazyTuiHub.Sdk.Avalonia"
    x:Class="LazyTuiHub.Sdk.Avalonia.AdaptivePane"
    x:DataType="local:AdaptivePane"
    x:Name="Root"
>
    <Grid x:Name="Columns" ColumnDefinitions="360,1,*">
        <ContentControl
            x:Name="MasterHost"
            Content="{Binding Master, ElementName=Root}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Tapped="MasterTapped"
        />
        <Border x:Name="Divider" Grid.Column="1" Background="{DynamicResource DividerBrush}" />
        <Grid
            x:Name="DetailHost"
            Grid.Column="2"
            RowDefinitions="Auto,*"
            Background="{DynamicResource SurfaceBrush}"
        >
            <Button
                x:Name="Back"
                Classes="quiet"
                AutomationProperties.Name="{Binding BackLabel, ElementName=Root}"
                Click="BackClick"
                Margin="20,12"
                HorizontalAlignment="Left"
                IsVisible="False"
            >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Classes="action inline" Data="{DynamicResource ActionIconBack}" />
                    <TextBlock
                        Text="{Binding BackLabel, ElementName=Root}"
                        VerticalAlignment="Center"
                    />
                </StackPanel>
            </Button>
            <ContentControl
                Grid.Row="1"
                Content="{Binding Detail, ElementName=Root}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
            />
        </Grid>
    </Grid>
</UserControl>
