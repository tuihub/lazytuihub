<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LazyTuiHub.Rss.Desktop"
    xmlns:rss="clr-namespace:LazyTuiHub.Api.Rss.V1;assembly=LazyTuiHub.Api"
    x:Class="LazyTuiHub.Rss.Desktop.ReaderPage"
    x:DataType="local:ReaderModel"
>
    <Grid RowDefinitions="Auto,*,Auto" Margin="0,16,0,0">
        <StackPanel Spacing="12" IsEnabled="{Binding Idle}">
            <TextBlock Text="Reader" Classes="title" />
            <Expander
                Header="Add subscription"
                HorizontalAlignment="Stretch"
                IsExpanded="{Binding AddingSubscription, Mode=TwoWay}"
            >
                <Grid ColumnDefinitions="2*,*,Auto">
                    <TextBox
                        x:Name="FeedUriInput"
                        Text="{Binding FeedUri}"
                        PlaceholderText="Feed URL"
                        Margin="0,0,8,8"
                    />
                    <TextBox
                        Grid.Column="1"
                        Text="{Binding FeedTitle}"
                        PlaceholderText="Name (optional)"
                        Margin="0,0,8,8"
                    />
                    <Button
                        Grid.Column="2"
                        Classes="primary"
                        Content="Subscribe"
                        Click="SubscribeClick"
                    />
                </Grid>
            </Expander>
            <WrapPanel>
                <ComboBox
                    x:Name="FeedPicker"
                    ItemsSource="{Binding Feeds}"
                    SelectedItem="{Binding SelectedFeed, Mode=OneWay}"
                    SelectionChanged="FeedChanged"
                    MinWidth="180"
                    MaxWidth="320"
                    Margin="0,0,8,8"
                >
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:FeedChoice">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox
                    x:Name="ReadFilter"
                    SelectedValue="{Binding Filter, Mode=OneWay}"
                    SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                    SelectionChanged="FilterChanged"
                    Margin="0,0,8,8"
                >
                    <ComboBoxItem Content="All articles" Tag="" /><ComboBoxItem
                        Content="Unread"
                        Tag="read = false"
                    /><ComboBoxItem Content="Read" Tag="read = true" />
                </ComboBox>
                <Button Content="Fetch" IsEnabled="{Binding CanRefresh}" Click="FetchClick" />
                <Button Content="Reload" Click="ReloadClick" />
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="2*,12,3*" IsEnabled="{Binding Idle}">
            <Grid RowDefinitions="*,Auto">
                <ListBox
                    x:Name="ArticleList"
                    ItemsSource="{Binding Articles}"
                    SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                >
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem" x:DataType="rss:Article">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="rss:Article">
                            <StackPanel Spacing="4" Margin="4,8">
                                <TextBlock
                                    Text="{Binding Title}"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"
                                />
                                <TextBlock
                                    Text="Read"
                                    IsVisible="{Binding Read}"
                                    Classes="caption"
                                />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button
                    Grid.Row="1"
                    Content="Load more"
                    IsVisible="{Binding HasMore}"
                    Click="MoreClick"
                    Margin="0,8,0,0"
                />
            </Grid>
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">
                <TextBlock
                    Text="{Binding SelectedArticle.Title}"
                    FontSize="22"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"
                />
                <TextBox
                    Grid.Row="1"
                    Text="{Binding SelectedArticle.Uri, Mode=OneWay}"
                    IsReadOnly="True"
                    PlaceholderText="Article link"
                    Margin="0,0,0,12"
                />
                <Button
                    Grid.Row="2"
                    Content="Mark read"
                    IsEnabled="{Binding CanMarkRead}"
                    Click="ReadClick"
                />
                <TextBox
                    Grid.Row="3"
                    x:Name="ArticleContent"
                    Text="{Binding SelectedArticle.Content, Mode=OneWay}"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2">
            <ProgressBar
                IsIndeterminate="True"
                IsVisible="{Binding Busy}"
                Height="2"
                Margin="0,12,0,0"
            />
            <TextBlock Text="{Binding Status}" Classes="status" />
        </StackPanel>
    </Grid>
</UserControl>
