<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Views require injected services and use compiled InitializeComponent, never URI-based construction. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LazyTuiHub.Desktop/LazyTuiHub.Desktop.csproj" />
    <ProjectReference Include="../LazyTuiHub.Api/LazyTuiHub.Api.csproj" />
  </ItemGroup>
</Project>
