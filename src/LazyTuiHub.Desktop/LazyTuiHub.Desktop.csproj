<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Views require injected services and use compiled InitializeComponent, never URI-based construction. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LazyTuiHub.Plugins/LazyTuiHub.Plugins.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Devolutions.AvaloniaTheme.MacOS" Version="2026.11.5" />
    <PackageReference Include="CCSWE.Avalonia.Material" Version="12.2.1" />
    <AvaloniaResource Include="Appearance/Fonts/*.ttf" />
    <None Update="Appearance/Icons/*-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Appearance/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
