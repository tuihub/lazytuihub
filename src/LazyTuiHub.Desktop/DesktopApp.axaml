<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="LazyTuiHub.Desktop.DesktopApp"
    Name="LazyTuiHub"
    RequestedThemeVariant="Default"
>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,8" /><Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="24" /><Setter
                Property="FontWeight"
                Value="SemiBold"
            />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Opacity" Value="0.7" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="Margin" Value="0,12,0,0" /><Setter
                Property="TextWrapping"
                Value="Wrap"
            />
        </Style>
    </Application.Styles>
</Application>
