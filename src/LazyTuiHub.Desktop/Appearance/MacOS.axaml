<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mac="using:Devolutions.AvaloniaTheme.MacOS"
>
    <Styles.Resources>
        <ResourceDictionary>
            <Thickness x:Key="PagePadding">20</Thickness>
            <x:Double x:Key="PageTitleSize">22</x:Double>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackground">#F5F5F5</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryText">#636363</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackground">#242424</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryText">#B0B0B0</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <mac:DevolutionsMacOsTheme />
</Styles>
