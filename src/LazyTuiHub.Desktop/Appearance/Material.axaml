<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
>
    <Styles.Resources>
        <ResourceDictionary>
            <Thickness x:Key="PagePadding">24</Thickness>
            <x:Double x:Key="PageTitleSize">24</x:Double>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PrimaryText">#242424</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentBrush">#6750A4</SolidColorBrush>
                    <SolidColorBrush x:Key="HoverBrush">#EDEFF2</SolidColorBrush>
                    <SolidColorBrush x:Key="SelectionBrush">#E4EAF6</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="DividerBrush">#18000000</SolidColorBrush>
                    <SolidColorBrush x:Key="PageBackground">#FAFAFA</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryText">#616161</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PrimaryText">#EAEAEA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentBrush">#A8C6FF</SolidColorBrush>
                    <SolidColorBrush x:Key="HoverBrush">#35383E</SolidColorBrush>
                    <SolidColorBrush x:Key="SelectionBrush">#343F55</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#292929</SolidColorBrush>
                    <SolidColorBrush x:Key="DividerBrush">#20FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="PageBackground">#303030</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryText">#BDBDBD</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <material:MaterialTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Teal" />
</Styles>
