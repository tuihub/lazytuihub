<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LazyTuiHub.Desktop"
    xmlns:plugins="clr-namespace:LazyTuiHub.Plugins;assembly=LazyTuiHub.Plugins"
    x:Class="LazyTuiHub.Desktop.PluginsPage"
>
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="24,20" Spacing="4">
            <TextBlock Text="Plugins" Classes="title" />
            <TextBlock x:Name="PluginCount" Classes="caption" />
        </StackPanel>
        <local:AdaptivePane x:Name="Pane" Grid.Row="1" BackLabel="Back to plugins">
            <local:AdaptivePane.Master>
                <ListBox
                    x:Name="Plugins"
                    SelectionChanged="SelectionChanged"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                >
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem" x:DataType="plugins:PluginView">
                            <Setter
                                Property="AutomationProperties.Name"
                                Value="{Binding Saved.Spec.Name}"
                            />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="plugins:PluginView">
                            <StackPanel Spacing="8" Margin="8,12">
                                <TextBlock
                                    Text="{Binding Saved.Spec.Name}"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"
                                />
                                <TextBlock Text="{Binding Activation}" Classes="caption" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </local:AdaptivePane.Master>
            <local:AdaptivePane.Detail>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28" Spacing="24" MaxWidth="760">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="PluginTitle"
                                FontSize="24"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                            />
                            <SelectableTextBlock
                                x:Name="PluginId"
                                Foreground="{DynamicResource SecondaryText}"
                                FontSize="12"
                                TextWrapping="Wrap"
                            />
                        </StackPanel>
                        <Border
                            Background="{DynamicResource PageBackground}"
                            CornerRadius="8"
                            Padding="20"
                        >
                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="16"
                                ColumnSpacing="12"
                            >
                                <TextBlock Text="This session" Classes="caption" />
                                <TextBlock
                                    x:Name="Activation"
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                />
                                <TextBlock Text="Plugin files" Grid.Row="1" Classes="caption" />
                                <TextBlock x:Name="Availability" Grid.Row="1" Grid.Column="1" />
                                <TextBlock Text="After restart" Grid.Row="2" Classes="caption" />
                                <TextBlock x:Name="SavedPreference" Grid.Row="2" Grid.Column="1" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="Reason" TextWrapping="Wrap" />
                        <StackPanel x:Name="PageSection" Spacing="8">
                            <TextBlock Text="Pages" FontWeight="SemiBold" />
                            <TextBlock x:Name="DeclaredPages" Classes="caption" />
                        </StackPanel>
                        <Border
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,24,0,0"
                        >
                            <StackPanel Spacing="12">
                                <TextBlock
                                    x:Name="RequiredNotice"
                                    Text="This core plugin is always enabled."
                                    Classes="caption"
                                />
                                <Button
                                    x:Name="Toggle"
                                    Click="ToggleClick"
                                    HorizontalAlignment="Left"
                                />
                                <TextBlock
                                    x:Name="RestartNotice"
                                    Text="Changes apply after restarting the application. Your data is kept."
                                    Classes="caption"
                                />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </local:AdaptivePane.Detail>
        </local:AdaptivePane>
        <TextBlock Grid.Row="2" x:Name="Status" Classes="caption" FontSize="12" Margin="20,8" />
    </Grid>
</UserControl>
