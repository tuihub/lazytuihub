<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="LazyTuiHub.Desktop.OperationsPage"
>
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="Operations" Classes="title" />
        <TextBox
            x:Name="Search"
            Grid.Row="1"
            PlaceholderText="Find an operation"
            AutomationProperties.Name="Find an operation"
            TextChanged="SearchChanged"
        />
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <ComboBox
                    x:Name="Choices"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Operation"
                    SelectionChanged="SelectOperation"
                />
                <TextBlock x:Name="Description" TextWrapping="Wrap" Classes="caption" />
                <StackPanel x:Name="Fields" Spacing="8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="Execute" Content="Run" Classes="primary" Click="RunClick" />
                    <Button x:Name="Stop" Content="Cancel" IsVisible="False" Click="StopClick" />
                </StackPanel>
                <ListBox
                    x:Name="Result"
                    AutomationProperties.Name="Operation result"
                    IsVisible="False"
                    MaxHeight="280"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                >
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding .}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="Status" Grid.Row="3" Classes="caption" TextWrapping="Wrap" />
    </Grid>
</UserControl>
