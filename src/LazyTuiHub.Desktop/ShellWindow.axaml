<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LazyTuiHub.Desktop"
    x:Class="LazyTuiHub.Desktop.ShellWindow"
    Title="LazyTuiHub"
    Width="1280"
    Height="820"
    Background="{DynamicResource PageBackground}"
>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border
            x:Name="CompactHeader"
            IsVisible="False"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource CompactHeaderPadding}"
        >
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button
                    x:Name="MenuButton"
                    Classes="icon"
                    AutomationProperties.Name="Navigation menu"
                    ToolTip.Tip="Navigation menu"
                    Click="MenuClick"
                    Margin="0,0,16,0"
                >
                    <PathIcon Classes="action" Data="{DynamicResource ActionIconNavigation}" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Text="LazyTuiHub"
                    Classes="item-title"
                    VerticalAlignment="Center"
                />
                <ContentControl x:Name="HeaderTools" Grid.Column="2" />
            </Grid>
        </Border>
        <SplitView
            x:Name="NavigationSplit"
            Grid.Row="1"
            DisplayMode="Inline"
            IsPaneOpen="True"
            CompactPaneLength="48"
            OpenPaneLength="208"
            PaneBackground="{DynamicResource PageBackground}"
        >
            <SplitView.Pane>
                <Grid x:Name="Sidebar" RowDefinitions="Auto,*,Auto" Margin="12,24,12,16">
                    <Button
                        x:Name="PaneToggle"
                        Classes="icon"
                        IsVisible="False"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Navigation menu"
                        ToolTip.Tip="Navigation menu"
                        Click="MenuClick"
                    >
                        <PathIcon Classes="action" Data="{DynamicResource ActionIconNavigation}" />
                    </Button>
                    <StackPanel x:Name="SidebarBrand" Margin="12,0,0,32" Spacing="4">
                        <TextBlock Text="LazyTuiHub" Classes="section" />
                    </StackPanel>
                    <ListBox
                        x:Name="Pages"
                        Grid.Row="1"
                        SelectionChanged="PageChanged"
                        BorderThickness="0"
                        Classes="navigation"
                    >
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:NavigationPage">
                                <StackPanel Classes="destination">
                                    <Border Classes="destination-icon">
                                        <PathIcon Classes="action" Data="{Binding Icon}" />
                                    </Border>
                                    <TextBlock
                                        Classes="destination-label"
                                        Text="{Binding Title}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="AppearanceTools" Grid.Row="2" Spacing="8">
                        <Button
                            x:Name="AppearanceButton"
                            Classes="quiet"
                            AutomationProperties.Name="Appearance"
                            HorizontalAlignment="Stretch"
                            Margin="0"
                        >
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon
                                    x:Name="AppearanceIcon"
                                    Classes="action inline"
                                    Data="{DynamicResource ActionIconAppearance}"
                                />
                                <TextBlock
                                    x:Name="AppearanceLabel"
                                    Text="Appearance"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="RightEdgeAlignedBottom">
                                    <StackPanel Spacing="12" Width="240" Margin="8">
                                        <TextBlock Text="Appearance" Classes="section" />
                                        <TextBlock Text="Design system" Classes="caption" />
                                        <ComboBox
                                            x:Name="DesignPicker"
                                            AutomationProperties.Name="Design system"
                                            SelectionChanged="AppearanceChanged"
                                            HorizontalAlignment="Stretch"
                                        >
                                            <ComboBoxItem Content="Automatic" /><ComboBoxItem Content="Fluent" />
                                            <ComboBoxItem Content="macOS" /><ComboBoxItem Content="Material" />
                                        </ComboBox>
                                        <TextBlock Text="Color mode" Classes="caption" />
                                        <ComboBox
                                            x:Name="ColorPicker"
                                            AutomationProperties.Name="Color mode"
                                            SelectionChanged="AppearanceChanged"
                                            HorizontalAlignment="Stretch"
                                        >
                                            <ComboBoxItem Content="System" /><ComboBoxItem Content="Light" />
                                            <ComboBoxItem Content="Dark" />
                                        </ComboBox>
                                        <TextBlock
                                            Text="{Binding Text, ElementName=AppearanceStatus}"
                                            Classes="caption"
                                        />
                                        <CheckBox
                                            x:Name="MotionPicker"
                                            Content="Reduce motion"
                                            IsCheckedChanged="AppearanceChanged"
                                        />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock
                            x:Name="AppearanceStatus"
                            TextWrapping="Wrap"
                            Classes="caption"
                        />
                    </StackPanel>
                </Grid>
            </SplitView.Pane>
            <Border
                x:Name="PageSurface"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1,0,0,0"
            >
                <ContentControl
                    x:Name="PageContent"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                />
            </Border>
        </SplitView>
        <ContentControl
            x:Name="BottomNavigation"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsVisible="False"
        />
    </Grid>
</Window>
