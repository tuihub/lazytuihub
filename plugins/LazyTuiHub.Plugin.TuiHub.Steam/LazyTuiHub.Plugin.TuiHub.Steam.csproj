<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PluginId>lazytuihub.plugin.tuihub.steam</PluginId>
    <Title>Steam</Title>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PluginEntryPoint Include="Server" Type="$(RootNamespace).SteamPlugin" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LazyTuiHub.Sdk/LazyTuiHub.Sdk.csproj" />
    <ProjectReference Include="../LazyTuiHub.Plugin.TuiHub.Games/LazyTuiHub.Plugin.TuiHub.Games.csproj"
                      PluginRelation="Requires" PluginVersionRange="[1.0.0,2.0.0)" />
  </ItemGroup>
</Project>
