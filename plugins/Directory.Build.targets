<Project>
  <Import Project="../Directory.Build.targets" />
  <Import Project="../src/LazyTuiHub.Sdk/build/LazyTuiHub.Sdk.targets" />
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LazyTuiHub.Tests" />
    <Compile Remove="**/bin/**;**/obj/**;tests/**" />
    <AvaloniaXaml Remove="**/bin/**;**/obj/**;tests/**" />
  </ItemGroup>
</Project>
