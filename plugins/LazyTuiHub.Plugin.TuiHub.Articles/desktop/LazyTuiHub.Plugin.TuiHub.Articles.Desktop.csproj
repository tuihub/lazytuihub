  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/LazyTuiHub.Desktop/LazyTuiHub.Desktop.csproj" />
    <ProjectReference Include="../client/LazyTuiHub.Plugin.TuiHub.Articles.Client.csproj" />
    <ProjectReference Include="../../LazyTuiHub.Plugin.TuiHub.Rss/client/LazyTuiHub.Plugin.TuiHub.Rss.Client.csproj" />
  </ItemGroup>
</Project>
