<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LazyTuiHub.Plugin.TuiHub.Articles.Desktop"
    xmlns:desktop="clr-namespace:LazyTuiHub.Sdk.Avalonia;assembly=LazyTuiHub.Sdk.Avalonia"
    xmlns:articles="clr-namespace:LazyTuiHub.Api.Articles.V1"
    x:ClassModifier="internal"
    x:Class="LazyTuiHub.Plugin.TuiHub.Articles.Desktop.ReaderPage"
    x:DataType="local:ReaderModel"
    x:Name="ReaderRoot"
>
    <Grid RowDefinitions="*,Auto">
        <desktop:AdaptivePane
            x:Name="ReaderPane"
            BackLabel="Back to articles"
            IsEnabled="{Binding !AddingSubscription}"
            DetailOpen="{Binding DetailOpen, Mode=TwoWay}"
        >
            <desktop:AdaptivePane.Master>
                <Grid RowDefinitions="Auto,*,Auto" IsEnabled="{Binding Idle}">
                    <StackPanel Margin="24,24,24,20" Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Library" Classes="title" />
                                <TextBlock Text="{Binding ArticleCount}" Classes="metadata" />
                            </StackPanel>
                            <Button
                                x:Name="AddFeedButton"
                                IsVisible="{Binding CanSubscribe}"
                                Classes="icon"
                                Grid.Column="1"
                                Click="AddFeedClick"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Add a subscription"
                                AutomationProperties.Name="Add subscription"
                            >
                                <PathIcon Classes="action" Data="{DynamicResource ActionIconAdd}" />
                            </Button>
                        </Grid>
                        <ComboBox
                            x:Name="FeedPicker"
                            IsVisible="{Binding CanSubscribe}"
                            ItemsSource="{Binding Feeds}"
                            HorizontalAlignment="Stretch"
                            SelectedItem="{Binding SelectedFeed, Mode=OneWay}"
                            SelectionChanged="FeedChanged"
                            AutomationProperties.Name="Subscription"
                        >
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:FeedChoice">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <ComboBox
                                x:Name="ReadFilter"
                                HorizontalAlignment="Stretch"
                                SelectedValue="{Binding Filter, Mode=OneWay}"
                                SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                                SelectionChanged="FilterChanged"
                                AutomationProperties.Name="Read status"
                            >
                                <ComboBoxItem Content="All articles" Tag="" /><ComboBoxItem
                                    Content="Unread"
                                    Tag="read = false"
                                />
                                <ComboBoxItem Content="Read" Tag="read = true" />
                            </ComboBox>
                            <Button
                                x:Name="RefreshButton"
                                Classes="icon"
                                Grid.Column="1"
                                Click="RefreshClick"
                                ToolTip.Tip="{Binding RefreshLabel}"
                                AutomationProperties.Name="{Binding RefreshLabel}"
                            >
                                <PathIcon
                                    Classes="action"
                                    Data="{DynamicResource ActionIconRefresh}"
                                />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Header="Reload saved articles"
                                            Click="ReloadClick"
                                        />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListBox
                            x:Name="ArticleList"
                            Classes="collection"
                            ItemsSource="{Binding Articles}"
                            SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                            SelectionChanged="ArticleChanged"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        >
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="articles:Article">
                                    <Setter
                                        Property="AutomationProperties.Name"
                                        Value="{Binding Title}"
                                    />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="articles:Article">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock
                                                Text="{Binding Converter={x:Static local:ArticleDisplay.Source}}"
                                                Classes="caption"
                                                FontSize="11"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                            <Ellipse
                                                Grid.Column="1"
                                                Width="6"
                                                Height="6"
                                                Fill="{DynamicResource AccentBrush}"
                                                IsVisible="{Binding !Read}"
                                                VerticalAlignment="Center"
                                            />
                                        </Grid>
                                        <TextBlock
                                            Text="{Binding Converter={x:Static local:ArticleDisplay.Title}}"
                                            Classes="item-title"
                                            TextWrapping="Wrap"
                                            MaxLines="3"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                        <TextBlock
                                            Text="{Binding Content}"
                                            Classes="caption"
                                            MaxLines="2"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                        <TextBlock
                                            Text="{Binding Converter={x:Static local:ArticleDisplay.Date}}"
                                            Classes="metadata"
                                        />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel
                            IsVisible="{Binding !HasArticles}"
                            VerticalAlignment="Center"
                            Margin="32"
                            Spacing="12"
                        >
                            <TextBlock Text="No articles yet" Classes="title" />
                            <TextBlock Text="{Binding EmptyMessage}" Classes="caption" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button
                            Content="Load more"
                            Classes="quiet"
                            IsVisible="{Binding HasMore}"
                            Click="MoreClick"
                            HorizontalAlignment="Stretch"
                            Margin="16,8"
                        />
                    </StackPanel>
                </Grid>
            </desktop:AdaptivePane.Master>
            <desktop:AdaptivePane.Detail>
                <Grid>
                    <ScrollViewer
                        x:Name="ArticleScroll"
                        HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding HasSelection}"
                    >
                        <StackPanel MaxWidth="700" Margin="32,40" Spacing="24">
                            <TextBlock
                                Text="{Binding SelectedArticle, Converter={x:Static local:ArticleDisplay.Source}}"
                                Foreground="{DynamicResource AccentBrush}"
                                Classes="label"
                            />
                            <SelectableTextBlock
                                Text="{Binding SelectedArticle, Converter={x:Static local:ArticleDisplay.Title}}"
                                Classes="headline"
                                TextWrapping="Wrap"
                            />
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock
                                    Text="{Binding PublishedAt}"
                                    Classes="metadata"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,8"
                                />
                                <Button
                                    x:Name="MarkReadButton"
                                    Classes="secondary"
                                    Content="Mark read"
                                    IsEnabled="{Binding CanMarkRead}"
                                    Click="ReadClick"
                                    Margin="0,0,0,8"
                                />
                            </WrapPanel>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" />
                            <SelectableTextBlock
                                x:Name="ArticleContent"
                                Text="{Binding SelectedArticle.Content}"
                                Classes="reading"
                                TextWrapping="Wrap"
                            />
                            <SelectableTextBlock
                                Text="{Binding SelectedArticle.Uri}"
                                Classes="metadata"
                                TextWrapping="Wrap"
                                Margin="0,16,0,0"
                            />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel
                        IsVisible="{Binding !HasSelection}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="280"
                        Margin="28"
                        Spacing="12"
                    >
                        <TextBlock Text="Select an article" Classes="title" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </desktop:AdaptivePane.Detail>
        </desktop:AdaptivePane>
        <StackPanel Grid.Row="1">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="2" />
            <TextBlock
                x:Name="OperationError"
                Text="{Binding Status}"
                IsVisible="{Binding Failed}"
                Classes="caption"
                Margin="20,12"
            />
        </StackPanel>
        <Grid
            Grid.RowSpan="2"
            KeyboardNavigation.TabNavigation="Cycle"
            IsVisible="{Binding AddingSubscription}"
            Background="#60000000"
        >
            <Border
                HorizontalAlignment="Right"
                Width="360"
                MaxWidth="{Binding Bounds.Width, ElementName=ReaderRoot}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1,0,0,0"
            >
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24" Spacing="20">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Text="New subscription"
                                Classes="title"
                                VerticalAlignment="Center"
                            />
                            <Button
                                Grid.Column="1"
                                x:Name="CloseSubscriptionButton"
                                ToolTip.Tip="Close"
                                AutomationProperties.Name="Close subscription form"
                                Classes="icon"
                                Click="CloseSubscriptionClick"
                            >
                                <PathIcon
                                    Classes="action"
                                    Data="{DynamicResource ActionIconClose}"
                                />
                            </Button>
                        </Grid>
                        <TextBlock
                            Text="Follow a site by adding its RSS or Atom feed."
                            Classes="caption"
                        />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Feed URL" />
                            <TextBox
                                x:Name="FeedUriInput"
                                Text="{Binding FeedUri}"
                                PlaceholderText="https://example.com/feed.xml"
                                AutomationProperties.Name="Feed URL"
                            />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Name (optional)" />
                            <TextBox
                                x:Name="FeedTitleInput"
                                Text="{Binding FeedTitle}"
                                PlaceholderText="A name for this feed"
                                AutomationProperties.Name="Feed name"
                            />
                        </StackPanel>
                        <Button
                            Classes="accent"
                            x:Name="SubscribeButton"
                            Content="Subscribe"
                            Click="SubscribeClick"
                            IsEnabled="{Binding Idle}"
                            HorizontalAlignment="Stretch"
                        />
                        <TextBlock
                            Text="{Binding Status}"
                            IsVisible="{Binding Failed}"
                            Classes="caption"
                        />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
