<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PluginId>lazytuihub.plugin.tuihub.storage.sqlite</PluginId>
    <Title>SQLite Storage</Title>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PluginEntryPoint Include="Server" Type="$(RootNamespace).SqliteStoragePlugin" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LazyTuiHub.Sdk/LazyTuiHub.Sdk.csproj" />
  </ItemGroup>
</Project>
