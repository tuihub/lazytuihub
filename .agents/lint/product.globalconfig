is_global = true

dotnet_diagnostic.CA1821.severity = error
dotnet_diagnostic.CA2200.severity = error

dotnet_diagnostic.CA1508.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA2213.severity = warning
dotnet_diagnostic.CA2025.severity = warning
dotnet_diagnostic.CA1851.severity = warning
dotnet_diagnostic.CA2012.severity = warning
dotnet_diagnostic.CA2253.severity = warning
dotnet_diagnostic.CA2254.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_code_quality_unused_parameters = all

dotnet_diagnostic.MA0009.severity = warning
dotnet_diagnostic.MA0040.severity = warning
dotnet_diagnostic.MA0042.severity = warning
dotnet_diagnostic.MA0051.severity = warning
dotnet_diagnostic.MA0054.severity = warning
dotnet_diagnostic.MA0182.severity = warning

dotnet_diagnostic.S109.severity = warning
dotnet_diagnostic.S1144.severity = warning
dotnet_diagnostic.S1192.severity = warning
dotnet_diagnostic.S1541.severity = warning
dotnet_diagnostic.S3776.severity = warning

# MA0040 owns cancellation propagation; CA2025 owns asynchronous disposal.
dotnet_diagnostic.CA2016.severity = none
dotnet_diagnostic.S8949.severity = none
dotnet_diagnostic.MA0100.severity = none

# Context capture and finalizer ownership depend on the implementation.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0055.severity = none

# Complexity is configured once through SonarLint.xml.
dotnet_diagnostic.CA1502.severity = none
