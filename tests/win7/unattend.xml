      <AutoLogon><Password><Value>LAB_PASSWORD</Value><PlainText>true</PlainText></Password><Username>Lab</Username><Enabled>true</Enabled><LogonCount>1</LogonCount></AutoLogon>
      <OOBE><HideEULAPage>true</HideEULAPage><NetworkLocation>Work</NetworkLocation><ProtectYourPC>3</ProtectYourPC></OOBE>
