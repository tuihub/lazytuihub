{
  "name": "lazy-tuihub",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "prepare": "node .agents/scripts/commits.mjs setup",
    "lint:markdown": "remark . --ext md --frail --no-stdout"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "conventional-commits-parser": "7.1.4",
    "ignore": "6.0.2",
    "jscpd": "5.4.3",
    "remark": "15.0.1",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-lint-fenced-code-flag": "4.2.0",
    "remark-lint-heading-increment": "4.0.1",
    "remark-lint-no-duplicate-headings-in-section": "4.0.1",
    "remark-preset-lint-consistent": "6.0.1",
    "remark-preset-lint-recommended": "7.0.1",
    "remark-validate-links": "13.1.0",
    "yaml": "2.9.1"
  }
}
